// Based on https://github.com/vercel/next.js/blob/canary/packages/create-next-app/templates/app-tw/ts/biome.json
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!output",
      "!out",
      "!public",
      "!references",
      "!src/assets/tray-icons.generated.ts",
      // Icon Composer document: Xcode-owned JSON, replaced wholesale on re-export.
      "!src/assets/icons/prod/icon.icon",
      "!storybook-static",
      // pnpm-owned: any reformat is undone on the next install.
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDuplicateProperties": "off",
        "noDuplicateCustomProperties": "off",
        // https://github.com/biomejs/biome/issues/7223
        "noUnknownAtRules": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "nursery": {
        // https://biomejs.dev/linter/rules/use-tailwind-sorted-classes/
        // https://github.com/biomejs/biome/issues/1274#issuecomment-3490774696
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "warn"
        }
      },
      // This should be removed after all css modules are migrated to tailwind
      "style": {
        "noDescendingSpecificity": "off"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:", ":PACKAGE:"],
              ":BLANK_LINE:",
              { "type": true },
              ":BLANK_LINE:",
              "@/types/**",
              ":BLANK_LINE:",
              "@/const/**",
              "@/data/**",
              ":BLANK_LINE:",
              "@/lib/**",
              ":BLANK_LINE:",
              "@/utils/**",
              ":BLANK_LINE:",
              "@/hooks/**",
              ":BLANK_LINE:",
              "@/handlers/**",
              ":BLANK_LINE:",
              "@/components/**",
              ":BLANK_LINE:",
              ["@/app/**", "@/pages/**"],
              "@/**"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "asNeeded"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    // TODO: remove on Biome 2.6.3+; 2.6.2 deletes the blank line between a paragraph and a list (biomejs/biome#12524)
    "formatter": {
      "enabled": false
    },
    // Opt-in: without it Biome formats YAML frontmatter as Markdown and mangles it.
    "parser": {
      "frontmatter": true
    }
  },
  "tailwind": {
    "attributes": ["class", "className", "classList"],
    "mergeFunctions": ["cn", "clsx", "tw"],
    "variantFunctions": ["cva"],
    "stylesheet": "./src/globals.css"
  }
}
